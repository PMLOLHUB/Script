_G.Speed = 200
local HttpService = game:GetService("HttpService")
local fileName = "SavedSessionConfig.json"

local hasDeclared = (getgenv().FruitWebhookUrl ~= nil) or (_G.Team ~= nil) or (getgenv().MoveMode ~= nil)

if hasDeclared then
    local configData = {
        FruitWebhookUrl = getgenv().FruitWebhookUrl or "",
        Team = _G.Team or "Pirate",
        Speed = _G.Speed
    }
    if writefile then
        writefile(fileName, HttpService:JSONEncode(configData))
    end
else
    if isfile and isfile(fileName) then
        local success, decodedData = pcall(function()
            return HttpService:JSONDecode(readfile(fileName))
        end)
        if success and decodedData then
            getgenv().FruitWebhookUrl = decodedData.FruitWebhookUrl
            _G.Team = decodedData.Team
            getgenv().MoveMode = decodedData.MoveMode
        end
    end
end

local queue = queue_on_teleport or (syn and syn.queue_on_teleport) or queueonteleport or (fluxus and fluxus.queue_on_teleport)
if queue then
    queue([[
        loadstring(game:HttpGet("https://raw.githubusercontent.com/PMLOLHUB/Script/refs/heads/main/Fruit%20finder"))()
    ]])
end
